# Copy to .env and fill in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vetmedagri?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:5173"

# Payment (HitPay) — fill when integrating checkout
HITPAY_API_KEY=""
HITPAY_SALT=""
HITPAY_API_URL="https://api.hit-pay.com/v1"

# WooCommerce → app product sync webhooks (see api/src/routes/webhooks.ts)
# WC_WEBHOOK_SECRET must match the secret set on each webhook in WooCommerce > Settings > Advanced > Webhooks.
WC_WEBHOOK_SECRET=""
# Optional — only needed to pull variation price/stock for variable products
# (WooCommerce's product webhook payload only lists variation ids, not their data).
WC_API_URL="https://old-wordpress-site.com/wp-json/wc/v3"
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""
