# Copy to .env and fill in production values before running docker compose up

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-run-openssl-rand-hex-32
SITE_URL=https://vetmedagri.net
MEDIA_BASE_URL=https://vetmedagri.net
CORS_ORIGIN=https://vetmedagri.net

# ── HitPay payment gateway ────────────────────────────────────────────────────
# Obtain from https://dashboard.hit-pay.com → Settings → API Keys
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_API_URL=https://api.hit-pay.com/v1
